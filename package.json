{
  "name": "alivemonitor",
  "version": "1.0.0",
  "description": "Uma plataforma onde usuários autenticados podem cadastrar URLs de diferentes serviços (sites, APIs, domínios) e receber alertas automáticos caso a aplicação monitorada fique offline, apresente erros ou demonstre alta latência.",
  "homepage": "https://github.com/caioolopes/AliveMonitor#readme",
  "bugs": {
    "url": "https://github.com/caioolopes/AliveMonitor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caioolopes/AliveMonitor.git"
  },
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "postinstall": "prisma skills sync || exit 0",
    "dev": "docker compose up -d && sleep 3 && npx prisma migrate deploy && next dev",
    "test": "vitest run"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "@network-utils/tcp-ping": "^1.2.3",
    "@prisma/client": "^7.10.0",
    "async-retry": "^1.3.3",
    "bcryptjs": "^3.0.3",
    "cookie": "^2.0.1",
    "eslint": "^10.9.1",
    "next": "^16.3.4",
    "next-connect": "^1.0.0",
    "pg": "^8.23.0",
    "set-cookie-parser": "^3.1.2",
    "swr": "^2.5.1",
    "uuid": "^14.0.2",
    "vitest": "^4.1.11"
  },
  "devDependencies": {
    "@swc/core": "^1.16.1",
    "@types/async-retry": "^1.4.9",
    "@types/node": "26.4.1",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.18",
    "dotenv": "^17.4.2",
    "prisma": "^7.10.0",
    "typescript": "^5.9.3",
    "unplugin-swc": "^1.5.11",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
